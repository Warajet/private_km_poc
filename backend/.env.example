# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Private KM Chatbot API"
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# ── GCP Core ───────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global

# ── Discovery Engine / Vertex AI Search ────────────────────────────────────────
# The datastore ID (last segment of the full resource path)
DISCOVERY_ENGINE_DATASTORE_ID=your-datastore-id
DISCOVERY_ENGINE_SERVING_CONFIG_ID=default_config

# ── Gemini ─────────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash-001
# GEMINI_SYSTEM_PROMPT="You are a helpful enterprise knowledge assistant..."

# ── Authentication ─────────────────────────────────────────────────────────────
# Path to SA key JSON for local dev (leave empty on Cloud Run / GKE — uses ADC)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# Google Workspace domain (e.g. hello.org)
WORKSPACE_DOMAIN=hello.org

# JWT issued by this API to frontend clients
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── Session persistence ────────────────────────────────────────────────────────
# "memory" for local dev, "redis" for production
SESSION_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# ── User Mapping ────────────────────────────────────────────────────────────────
# Path to a JSON file mapping HWC emails → {department, jd_code, relate_groups}
# USER_MAPPING_FILE=/app/config/user_mapping.json
