# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Private KM Chatbot API"
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# ── GCP Core ───────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global

# ── Discovery Engine ───────────────────────────────────────────────────────────
# Vertex AI Search App (engine) that has all bucket datastores attached.
# Required for answer_query() with DataStoreSpecs (engine-level serving config).
# Create via GCP Console → Vertex AI Search → Apps, then copy the engine ID.
DISCOVERY_ENGINE_ENGINE_ID=your-engine-id

# Serving config ID on the engine (usually "default_serving_config").
DISCOVERY_ENGINE_SERVING_CONFIG_ID=default_serving_config

# ── Datastore Registry ─────────────────────────────────────────────────────────
# Path to the JSON file that maps bucket types → Discovery Engine datastore IDs.
#
# Bucket layout:
#   public       → 1 shared datastore (all authenticated users)
#   internal     → N datastores, one per department (e.g. A, B, C)
#   relate       → K datastores, one per cross-dept relationship (e.g. ab, abc)
#   confidential → 1 datastore, JD-code-gated
#
# See scripts/datastore_registry.json for the schema.
DATASTORE_REGISTRY_FILE=/app/config/datastore_registry.json

# ── Gemini Enterprise ──────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash-001
# GEMINI_SYSTEM_PROMPT="You are a helpful enterprise knowledge assistant..."

# ── Authentication ─────────────────────────────────────────────────────────────
# Path to SA key JSON for local dev (leave empty on Cloud Run / GKE — uses ADC).
# The SA must have:
#   - roles/discoveryengine.viewer  (to call Discovery Engine Search API)
#   - roles/aiplatform.user         (to call Vertex AI / Gemini)
#   - Domain-wide Delegation enabled in Google Workspace Admin for DWD_SCOPES
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# Google Workspace domain (e.g. hello.org)
WORKSPACE_DOMAIN=hello.org

# DWD scopes the SA is allowed to use when impersonating Workspace users
DWD_SCOPES=https://www.googleapis.com/auth/cloud-platform

# ── Session persistence ────────────────────────────────────────────────────────
# "memory" for local dev, "redis" for production
SESSION_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# ── JWT for Frontend ↔ Backend ─────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── User Mapping ────────────────────────────────────────────────────────────────
# JSON file mapping HWC user emails → {department, jd_code, relate_groups}
# See scripts/seed_user_mapping.json for the schema.
USER_MAPPING_FILE=/app/config/user_mapping.json
