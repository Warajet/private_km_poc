.env.*.local

# Git
.git/
.gitignore

# Editor / OS
.DS_Store
*.pem
.vscode/
.idea/

# Docs (not needed at runtime)
*.md
DEPLOYMENT.md

# Test / CI artifacts
coverage/
.nyc_output/
