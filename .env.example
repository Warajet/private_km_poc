# Copy this file to .env.local and fill in your values

# Gemini API Key (from Google AI Studio or Vertex AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-pro

# JWT Secret - use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Optional: Custom system prompt for the AI assistant
# SYSTEM_PROMPT=You are a helpful assistant for our organization.
